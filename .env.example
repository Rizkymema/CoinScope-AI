# ---- AI (Claude) ---------------------------------------------------------
# Required for AI scoring, the AI trade gate and the AI control chat.
# Without it the app falls back to rule-based (heuristic) scoring and the chat is disabled.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# ---- Solana ---------------------------------------------------------------
# Public RPC works but is rate-limited; a Helius / QuickNode / Triton endpoint is recommended for live trading.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Jupiter API key (uses the free lite-api.jup.ag tier when empty)
# JUPITER_API_KEY=

# ---- MCP server (/api/mcp) + browser bridge -------------------------------
# Shared secret. MCP clients send it as `Authorization: Bearer <key>`; enter the same value in the
# dashboard (Login -> MCP Access Key). Leave unset only for local development (endpoint is then open).
COINSCOPE_ACCESS_KEY=change-me-to-a-long-random-string

# Optional but recommended on Vercel: Upstash Redis (Vercel Marketplace) so the bridge state is shared
# across serverless instances. Either pair works; Vercel injects them automatically when you add the store.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
